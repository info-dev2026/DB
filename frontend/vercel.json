{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/portal/live/push",
      "destination": "/api/live-push"
    },
    {
      "source": "/api/portal/live/preview",
      "destination": "/api/live-push"
    },
    {
      "source": "/api/live/push",
      "destination": "/api/live-push"
    },
    {
      "source": "/api/portal/live/boards/:siteId",
      "destination": "/api/board-config?siteId=:siteId"
    },
    {
      "source": "/api/portal/live/boards",
      "destination": "/api/board-config"
    },
    {
      "source": "/api/portal/live/config/:siteId",
      "destination": "/api/board-config?siteId=:siteId"
    },
    {
      "source": "/api/portal/live/config",
      "destination": "/api/board-config"
    },
    {
      "source": "/api/board-config",
      "destination": "/api/board-config"
    },
    {
      "source": "/api/portal/sites/next-param-id",
      "destination": "/api/next-param-id"
    },
    {
      "source": "/api/sites/next-param-id",
      "destination": "/api/next-param-id"
    },
    {
      "source": "/api/next-param-id",
      "destination": "/api/next-param-id"
    },
    {
      "source": "/api/datalogger/readings",
      "destination": "/api/datalogger"
    },
    {
      "source": "/api/datalogger/divert",
      "destination": "/api/datalogger"
    },
    {
      "source": "/api/datalogger/schema/:siteId",
      "destination": "/api/datalogger?siteId=:siteId"
    },
    {
      "source": "/api/datalogger/ping",
      "destination": "/api/datalogger?ping=true"
    },
    {
      "source": "/api/datalogger",
      "destination": "/api/datalogger"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://saaphzone-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
