# ============================================================
# Saaphzone OCEMS — Backend configuration
# Copy this to .env and fill in your values.
# ============================================================

# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- MongoDB ----------
# From MongoDB Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/saaphzone?retryWrites=true&w=majority

# ---------- JWT ----------
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES=8h

# ---------- Device API ----------
DEVICE_API_KEY=sz_device_key_change_me

# ---------- SMTP / Gmail ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
MAIL_FROM="Saaphzone OCEMS <your_email@gmail.com>"
ALERT_RECIPIENTS=your_email@gmail.com

# ---------- Device monitor ----------
OFFLINE_THRESHOLD_MINUTES=3
MONITOR_INTERVAL_MINUTES=1

# ---------- CORS ----------
CLIENT_ORIGIN=http://localhost:3001